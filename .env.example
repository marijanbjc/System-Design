# Скопируйте в .env и при необходимости поправьте. Демо работает без единой правки.

REDIS_URL=redis://localhost:6379/0
AUDIT_DB_PATH=audit.db

# LLM в PoC — детерминированный мок, API-ключ не нужен.
LLM_MODEL=mock-deterministic-v1

# Пороги маршрутизации (architecture.md §8.1)
TAU_HIGH=0.72
TAU_KB=0.40
TAU_CONF=0.70
TAU_CTX=0.55
CONF_CLS_MIN=0.45

# Детекция всплеска (architecture.md §6.1)
SURGE_THRESHOLD=5
SURGE_WINDOW_MINUTES=10

# Ограничение частоты вызовов LLM (architecture.md §9)
LLM_RATE_LIMIT_RPS=2
LLM_RATE_LIMIT_BURST=4
